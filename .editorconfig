# Editors and agents: UTF-8, LF, final newline. Java indent matches Spotless (AOSP, 4 spaces).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
